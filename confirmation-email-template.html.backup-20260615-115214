<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Confirm your email — Mitsuki</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", sans-serif;
      background: #fff5f7;
      color: #38222b;
      line-height: 1.65;
    }
    @media (prefers-color-scheme: dark) {
      body {
        background: #121424;
        color: rgba(255, 255, 255, 0.92);
      }
    }
    .email-container {
      max-width: 100%;
      background: #fff5f7;
      padding: 0;
    }
    @media (prefers-color-scheme: dark) {
      .email-container {
        background: #121424;
      }
    }
    .email-wrapper {
      max-width: 540px;
      margin: 0 auto;
      padding: 40px 24px;
    }
    .header {
      text-align: center;
      margin-bottom: 40px;
    }
    .logo {
      display: inline-block;
      margin-bottom: 20px;
    }
    .logo img {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: block;
    }
    .brand-name {
      font-size: 24px;
      font-weight: 700;
      letter-spacing: -0.01em;
      color: #38222b;
    }
    @media (prefers-color-scheme: dark) {
      .brand-name {
        color: rgba(255, 255, 255, 0.92);
      }
    }
    .content-box {
      background: #fffafc;
      border: 1px solid rgba(217, 140, 166, 0.18);
      border-radius: 16px;
      padding: 40px 32px;
      margin-bottom: 32px;
    }
    @media (prefers-color-scheme: dark) {
      .content-box {
        background: #212638;
        border-color: rgba(255, 255, 255, 0.08);
      }
    }
    h1 {
      font-size: 28px;
      font-weight: 600;
      margin-bottom: 16px;
      letter-spacing: -0.015em;
      color: #38222b;
    }
    @media (prefers-color-scheme: dark) {
      h1 {
        color: rgba(255, 255, 255, 0.92);
      }
    }
    .subtitle {
      font-size: 16px;
      color: rgba(56, 34, 43, 0.72);
      margin-bottom: 24px;
    }
    @media (prefers-color-scheme: dark) {
      .subtitle {
        color: rgba(255, 255, 255, 0.7);
      }
    }
    .cta-button {
      display: inline-block;
      background: #eb6b94;
      color: #ffffff;
      padding: 14px 32px;
      border-radius: 999px;
      font-size: 16px;
      font-weight: 620;
      text-decoration: none;
      letter-spacing: 0.01em;
      transition: background-color 0.2s ease;
      margin: 24px 0;
    }
    .cta-button:hover {
      background: #d94f7e;
    }
    .button-note {
      font-size: 14px;
      color: rgba(56, 34, 43, 0.56);
      margin-top: 20px;
    }
    @media (prefers-color-scheme: dark) {
      .button-note {
        color: rgba(255, 255, 255, 0.54);
      }
    }
    .divider {
      height: 1px;
      background: rgba(217, 140, 166, 0.18);
      margin: 32px 0;
    }
    @media (prefers-color-scheme: dark) {
      .divider {
        background: rgba(255, 255, 255, 0.08);
      }
    }
    .footer {
      padding: 0;
      text-align: center;
    }
    .footer-text {
      font-size: 13px;
      color: rgba(56, 34, 43, 0.56);
      line-height: 1.6;
    }
    @media (prefers-color-scheme: dark) {
      .footer-text {
        color: rgba(255, 255, 255, 0.54);
      }
    }
    .footer-link {
      color: #d94f7e;
      text-decoration: none;
    }
    .footer-link:hover {
      text-decoration: underline;
    }
    @media (max-width: 480px) {
      .email-wrapper {
        padding: 24px 16px;
      }
      .content-box {
        padding: 28px 20px;
      }
      h1 {
        font-size: 24px;
      }
    }
  </style>
</head>
<body>
  <div class="email-container">
    <div class="email-wrapper">
      <!-- Header -->
      <div class="header">
        <div class="logo">
          <img src="{{ .Data.logo_url }}" alt="Mitsuki" width="48" height="48">
        </div>
        <div class="brand-name">Mitsuki</div>
      </div>

      <!-- Main content -->
      <div class="content-box">
        <h1>Confirm your email</h1>
        <p class="subtitle">Welcome to Mitsuki. Confirm your email address to get started with your Japanese learning journey.</p>

        <center>
          <a href="{{ .ConfirmationURL }}" class="cta-button">Confirm Email</a>
        </center>

        <p class="button-note">Or copy this link in your browser:<br>
          <span style="word-break: break-all; font-size: 13px; color: rgba(56, 34, 43, 0.56);">{{ .ConfirmationURL }}</span>
        </p>
      </div>

      <div class="divider"></div>

      <!-- Footer -->
      <div class="footer">
        <p class="footer-text">
          Questions? <a href="mailto:support@mitsuki.app" class="footer-link">Contact us</a><br>
          <a href="https://mitsuki.app/privacy" class="footer-link">Privacy Policy</a>
        </p>
        <p class="footer-text" style="margin-top: 16px;">
          © 2026 Mitsuki. Japanese, made to stay.<br>
          {{ .Data.email }}
        </p>
      </div>
    </div>
  </div>
</body>
</html>
